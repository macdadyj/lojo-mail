<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>LOJO Mail</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1</string>
	<key>NSFaceIDUsageDescription</key>
	<string>LOJO Mail can ask for Face ID before it shows your mail.</string>
	<key>NSCameraUsageDescription</key>
	<string>Take a photo to attach to a message. Photos stay in memory until you send or close the draft.</string>
	<!--
	Background app refresh is an Info.plist capability, so it works with a free Apple ID.
	Push (APNs) needs the aps-environment entitlement, which free provisioning profiles do not grant.
	-->
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.lojo.Mail.refresh</string>
	</array>
	<!-- No NSAppTransportSecurity exceptions: the API is HTTPS only. -->
	<key>UIFileSharingEnabled</key>
	<false/>
	<!--
	Opening a file (AirDrop, share sheet, "Open in LOJO Mail") copies it into Documents/Inbox; the app reads the key,
	deletes the copy, and asks before storing it in the Keychain. Alternate rank: never the default app for JSON.
	-->
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Envelope key</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.lojo.jwk</string>
				<string>public.json</string>
			</array>
		</dict>
	</array>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.lojo.jwk</string>
			<key>UTTypeDescription</key>
			<string>JSON Web Key</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.json</string>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>jwk</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/jwk+json</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
