# Copy to terraform.tfvars (gitignored) before plan/apply.
# Defaults match the read-only audit: lojo@cyberphysical.us, SES in us-east-1.
# manage_dns stays false. The receipt rule set is active because no set was
# active in any region. Re-check that before apply.

aws_region         = "us-east-1"
domain             = "cyberphysical.us"
local_part         = "lojo"
ses_identity_mode  = "existing"

manage_dns               = false
dns_cutover_confirmation = ""
zone_id                  = ""
manage_active_rule_set   = true

# First deploy: only lojo-test@ is accepted, so the live checklist in
# docs/DEPLOY.md runs before real mail. Set "live" when it passes.
receiving_stage           = "test"
receiving_test_local_part = "lojo-test"

llm_provider       = "grok"
daily_token_budget = 100000

# Raw MIME is deleted after indexing; this only expires what failed.
raw_retention_days = 7
# Server-readable AI-context copies. 0 turns them off.
ai_context_days = 30

# SNS topic ARNs for the processor DLQ and error alarms.
alarm_actions = []

# After `npm run build:lambda`:
# processor_bundle = "../../packages/pipeline/dist/processor.mjs"
# api_bundle       = "../../packages/api/dist/api.mjs"

# Add the PWA's HTTPS origin before deploying it; this also sets S3 CORS for
# presigned attachment downloads.
web_origins = [
  "http://127.0.0.1:5173",
  "http://localhost:5173",
]

# Send in Thunderbird goes straight out through SES (no web approval). false
# puts Thunderbird sends in the web approval queue instead.
bridge_send_enabled = true
# Extra SES-verified From addresses for Thunderbird identities.
# send_from_addresses = ["jon@lojo.engineering"]
# client_send_limits = { per_day = 200, per_10_minutes = 30, recipients_per_day = 500, max_recipients = 50 }

# Also receive for another domain into the same mailbox. Creates an SES domain
# identity with Easy DKIM (no DNS, no MAIL FROM) and one extra receipt rule
# "store-raw-<domain>" for exactly these addresses (live stage only).
# extra_receiving_domains   = ["lojo.engineering"]
# extra_receiving_addresses = ["jon@lojo.engineering"]
