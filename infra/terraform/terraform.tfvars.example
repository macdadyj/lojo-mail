# Copy to terraform.tfvars (gitignored) before plan/apply.
# Defaults match the read-only audit: lojo@cyberphysical.us, SES in us-east-1.
# manage_dns stays false. The receipt rule set is active because no set was
# active in any region. Re-check that before apply.

aws_region         = "us-east-1"
domain             = "cyberphysical.us"
local_part         = "lojo"
ses_identity_mode  = "existing"

manage_dns               = false
dns_cutover_confirmation = ""
zone_id                  = ""
manage_active_rule_set   = true

llm_provider       = "grok"
daily_token_budget = 100000

# After `npm run build:lambda`:
# processor_bundle = "../../packages/pipeline/dist/processor.mjs"
# api_bundle       = "../../packages/api/dist/api.mjs"

web_origins = [
  "http://127.0.0.1:5173",
  "http://localhost:5173",
]
